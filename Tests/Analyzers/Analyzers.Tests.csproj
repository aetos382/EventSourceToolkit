<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aetos.EventSourceToolkit.Tests.Analyzers</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sources\Analyzers\Analyzers.csproj" />
    <ProjectReference Include="..\..\Sources\SourceGenerators\SourceGenerators.csproj" />
    <ProjectReference Include="..\TestUtilities\TestUtilities.csproj" />
  </ItemGroup>

  <!--
    AnalysisLevel によって SDK が暗黙的に登録する Microsoft.CodeAnalysis(.CSharp).NetAnalyzers.dll
    （%(Analyzer.IsImplicitlyDefined) == true）を、Suppressor テストからアナライザー型として
    直接 new できるようにコンパイル参照へ昇格させる。SDK 同梱パスをそのまま使うため、
    バージョン番号や NuGet パッケージへの依存を持たない。
  -->
  <Target Name="ReferenceBuiltInNetAnalyzersForTests" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_NetAnalyzersForTest Include="@(Analyzer)"
                            Condition="'%(Analyzer.IsImplicitlyDefined)' == 'true' And
                                       ('%(Analyzer.Filename)' == 'Microsoft.CodeAnalysis.CSharp.NetAnalyzers' Or
                                        '%(Analyzer.Filename)' == 'Microsoft.CodeAnalysis.NetAnalyzers')" />
      <Reference Include="@(_NetAnalyzersForTest)" />
    </ItemGroup>
  </Target>

</Project>
